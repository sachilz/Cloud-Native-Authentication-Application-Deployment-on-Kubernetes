{
  "name": "devops-task-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for DevOps Task Tracker in Minikube Kubernetes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest --detectOpenHandles --runInBand --forceExit"
  },
  "keywords": [
    "devops",
    "kubernetes",
    "minikube",
    "express",
    "postgres",
    "task-tracker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^1.14.10",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
